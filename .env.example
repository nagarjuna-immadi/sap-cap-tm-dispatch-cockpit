# Hub sandbox API key for hybrid mode (cds watch --profile hybrid).
# Copy to .env (git-ignored) and replace <your-hub-api-key> with the key from
# api.sap.com (Show API Key). Never commit the real key.
# Keys are scoped to [hybrid] so that plain `cds watch` keeps mocking the TM services.
cds.requires.CE_FREIGHTORDER_0001.[hybrid].credentials.headers.APIKey=<your-hub-api-key>
cds.requires.CE_FREIGHTUNIT_0001.[hybrid].credentials.headers.APIKey=<your-hub-api-key>
cds.requires.CE_FREIGHTBOOKING_0001.[hybrid].credentials.headers.APIKey=<your-hub-api-key>

# Anthropic API key for the agents (phase 6), used in the development and hybrid profiles.
# Create it at console.anthropic.com (with a monthly spend limit). Never commit the real key.
# ANTHROPIC_BASE_URL is set explicitly so that @cap-js/agents does not fall back to
# ~/.claude/settings.json or ~/.config/opencode/opencode.json for its settings.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com
