{
  "name": "sap-cap-tm-dispatch-cockpit",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/agents": "^0.9.7",
    "@cap-js/hana": "^3",
    "@cap-js/mcp": "^1.5.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-hybrid": "cds watch --profile hybrid",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "watch-dispatch-cockpit": "cds watch --open tm.dispatch.dispatchcockpit/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tender-desk": "cds watch --open tm.dispatch.tenderdesk/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "CE_FREIGHTBOOKING_0001": {
        "kind": "odata",
        "model": "srv/external/CE_FREIGHTBOOKING_0001",
        "max_get_url_length": 8192,
        "[hybrid]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_freightbooking/srvd_a2x/sap/freightbooking/0001"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "S4_SANDBOX",
            "path": "/sap/opu/odata4/sap/api_freightbooking/srvd_a2x/sap/freightbooking/0001"
          }
        }
      },
      "CE_FREIGHTORDER_0001": {
        "kind": "odata",
        "model": "srv/external/CE_FREIGHTORDER_0001",
        "max_get_url_length": 8192,
        "[hybrid]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_freightorder/srvd_a2x/sap/freightorder/0001"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "S4_SANDBOX",
            "path": "/sap/opu/odata4/sap/api_freightorder/srvd_a2x/sap/freightorder/0001"
          }
        }
      },
      "CE_FREIGHTUNIT_0001": {
        "kind": "odata",
        "model": "srv/external/CE_FREIGHTUNIT_0001",
        "max_get_url_length": 8192,
        "[hybrid]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_freightunit/srvd_a2x/sap/freightunit/0001"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "S4_SANDBOX",
            "path": "/sap/opu/odata4/sap/api_freightunit/srvd_a2x/sap/freightunit/0001"
          }
        }
      },
      "[development]": {
        "llm": {
          "kind": "anthropic",
          "model": "claude-haiku-4-5-20251001"
        }
      },
      "[hybrid]": {
        "llm": {
          "kind": "anthropic",
          "model": "claude-haiku-4-5-20251001"
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "[test]": {
        "llm": {
          "kind": "llm-mock"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "llm": {
          "kind": "anthropic",
          "model": "claude-sonnet-5-5",
          "vcap": {
            "name": "sap-cap-tm-dispatch-cockpit-llm"
          }
        },
        "attachments": {
          "kind": "db",
          "scan": false
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "server": {
      "[production]": {
        "index": true
      }
    },
    "fiori": {
      "[production]": {
        "preview": true
      }
    },
    "mcp": {
      "prefix": true,
      "per_action_tool": true
    },
    "agents": {
      "quotas": {
        "maxTasksPerHour": 30,
        "maxConcurrentTasksPerUser": 2,
        "maxIncomingMessageLength": 4000,
        "maxLLMCallTimeout": "60s"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/dispatch-cockpit",
    "app/tender-desk"
  ]
}
